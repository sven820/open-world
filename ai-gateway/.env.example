# AI 网关环境变量（复制为 .env 后填写；.env 不入库）

# 网关监听端口
AI_GATEWAY_PORT=8788

# 模型 provider（OpenAI 兼容端点，兼容 DeepSeek/通义/Moonshot/OpenAI/本地 vLLM）
# DeepSeek:  https://api.deepseek.com/v1           + deepseek-chat
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
# Moonshot:  https://api.moonshot.cn/v1            + moonshot-v1-8k
AI_PROVIDER_BASE_URL=https://api.deepseek.com/v1
AI_PROVIDER_API_KEY=sk-99f0c9effe8a49f0994d7cb37108afae
AI_PROVIDER_MODEL=deepseek-chat

# 视觉模型（以图捏脸用；可选，未配置时回退主模型）
# 通义: qwen-vl-max ｜ Moonshot: moonshot-v1-8k-vision-preview ｜ OpenAI: gpt-4o-mini
AI_PROVIDER_VISION_MODEL=deepseek-flash
